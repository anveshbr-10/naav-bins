# Copy to server/.env (never commit .env) and set the same variables in the Render dashboard.

# --- Supabase (database + authentication) ---
SUPABASE_URL=https://your-project.supabase.co
# Server-only secret key: Supabase → Project Settings → API Keys → Secret keys. Never put it in the frontend.
SUPABASE_SECRET_KEY=

# --- Smart-bin scan sessions ---
# Long random strings (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET signs short-lived bin-scan sessions (user logins are handled by Supabase Auth).
JWT_SECRET=
# QR_SECRET signs the printed bin QR codes. Changing it invalidates every printed code.
QR_SECRET=
SCAN_SESSION_TTL=5m
REWARD_COOLDOWN_SECONDS=30
DAILY_ITEM_LIMIT=30

# --- CORS ---
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

PORT=5000
