# Copy to server/.env (never commit .env) and set the same variables in the Render dashboard.

# --- Auth ---
# Long random string (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Smart-bin QR signing ---
# Long random string (min 32 chars). Changing it invalidates every printed bin QR code.
QR_SECRET=
SCAN_SESSION_TTL=5m
REWARD_COOLDOWN_SECONDS=30
DAILY_ITEM_LIMIT=30

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
# Server-only secret key (Project Settings -> API Keys -> Secret key). Required once RLS is enabled.
SUPABASE_SECRET_KEY=
# Legacy fallback only; used when SUPABASE_SECRET_KEY is empty.
SUPABASE_ANON_KEY=

# --- Firebase ---
# Full service-account JSON on one line. If empty, server/serviceAccountKey.json is used.
FIREBASE_CREDS=

# --- CORS ---
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

PORT=5000
