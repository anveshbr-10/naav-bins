# Copy to server/.env (never commit .env) and set the same variables in the Render dashboard.

# --- Supabase (database + authentication) ---
SUPABASE_URL=https://your-project.supabase.co
# Server-only secret key: Supabase → Project Settings → API Keys → Secret keys. Never put it in the frontend.
SUPABASE_SECRET_KEY=

# --- Smart-bin scan sessions ---
# Long random strings (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET signs short-lived bin-scan sessions (user logins are handled by Supabase Auth).
JWT_SECRET=
# QR_SECRET signs the printed bin QR codes. Changing it invalidates every printed code.
QR_SECRET=
SCAN_SESSION_TTL=5m

# --- Reward integrity (fraud controls) ---
# Cooldown per user per bin, and items per user per 24 hours.
REWARD_COOLDOWN_SECONDS=20
DAILY_ITEM_LIMIT=30
# Geofence: the phone must be within ~GEOFENCE_RADIUS_M of the bin (plus up to half that for GPS error).
# Fixes worse than GEOFENCE_MAX_ACCURACY_M are refused. Set GEOFENCE_ENABLED=false only for demos.
GEOFENCE_ENABLED=true
GEOFENCE_RADIUS_M=50
GEOFENCE_MAX_ACCURACY_M=100
# Duplicate-photo check: Hamming distance (out of 64 bits) at or below which two photos count as the same.
PHASH_THRESHOLD=6
DUPLICATE_WINDOW_DAYS=30
DUPLICATE_BIN_WINDOW_HOURS=24
# Rotating QR codes on bin screens: seconds per code.
DYNAMIC_QR_PERIOD_SECONDS=30

# --- Operations console ---
# Start point for collection routes (e.g. the waste yard). Optional.
DEPOT_LAT=
DEPOT_LNG=

# --- CORS ---
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

PORT=5000
