# Copy to client/smartbin/.env.local (local) or set in Vercel → Project → Settings → Environment Variables.
# All three are public values; defaults point at the production project when unset.

# Backend API (Express on Render)
VITE_API_URL=http://localhost:5000

# Supabase project (Authentication). Use the *publishable* key — never the secret key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Translations (optional, used only by `npm run i18n` / dev / build on your machine or CI) ---
# Not VITE_-prefixed, so they are never bundled into the app. When one is set, new UI strings are
# machine-translated into Kannada and Hindi automatically; review them in src/locales/*.json.
# GOOGLE_TRANSLATE_API_KEY=
# LIBRETRANSLATE_URL=
# LIBRETRANSLATE_API_KEY=
